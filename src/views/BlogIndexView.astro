---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPostCard from "../components/blog/BlogPostCard.astro";
import CategoryNav from "../components/blog/CategoryNav.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { getFeaturedPost, getPosts } from "../data/blog";
import { getLocale } from "../i18n";
import { dict } from "../i18n/ui";

const locale = getLocale(Astro.url);
const t = dict[locale].blog;
const featured = getFeaturedPost(locale);
const posts = getPosts(locale).filter((post) => post.slug !== featured.slug);
---

<BaseLayout title={t.metaTitle} description={t.metaDescription}>
  <section class="container-site pt-12 sm:pt-20">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} description={t.description} />
    <CategoryNav active="all" />
  </section>

  <section class="container-site pt-12">
    <BlogPostCard post={featured} featured />
  </section>

  <section class="container-site pt-5">
    <div class="grid gap-5 lg:grid-cols-2">
      {posts.map((post, i) => (
        <BlogPostCard post={post} delay={(i % 2) * 80} />
      ))}
    </div>
  </section>
</BaseLayout>
