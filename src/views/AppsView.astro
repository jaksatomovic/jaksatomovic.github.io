---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BlogPostCard from "../components/blog/BlogPostCard.astro";
import StudioCard from "../components/ui/StudioCard.astro";
import { getProjectsByArea } from "../data/projects";
import { getPostsByCategory } from "../data/blog";
import { getLocale, localePath } from "../i18n";
import { dict } from "../i18n/ui";

const locale = getLocale(Astro.url);
const t = dict[locale].apps;
const apps = getProjectsByArea("apps", locale);
const posts = getPostsByCategory("apps", locale).filter(post => post.tags.includes("TONKO")).slice(0, 2);
---

<BaseLayout title={t.metaTitle} description={t.metaDescription}>
  <section class="container-site pt-12 sm:pt-20">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="mt-4 text-display-lg font-semibold text-ink">{t.title}</h1>
      <p class="mt-4 text-base text-muted sm:text-lg">{t.description}</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <StudioCard />
      {apps.map((x, i) => (
        <ProjectCard project={x} variant={i === 0 ? "wide" : "default"} delay={i * 80} />
      ))}

    </div>
  </section>

  {posts.length > 0 && (
    <section class="container-site pt-24 sm:pt-32">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow={t.notesEyebrow} title={t.notesTitle} size="md" />
        <a href={localePath("/blog/apps", locale)} class="link-arrow shrink-0" data-reveal>
          {t.allProductNotes}
          <Icon name="arrow" />
        </a>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {posts.map((post, i) => (
          <BlogPostCard post={post} delay={i * 80} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
