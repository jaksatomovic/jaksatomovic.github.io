---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPostCard from "../components/blog/BlogPostCard.astro";
import Icon from "../components/ui/Icon.astro";
import { formatPostDate, getCategoryById, getPostBySlug, getPostsByCategory } from "../data/blog";
import { getLocale, localePath } from "../i18n";
import { dict } from "../i18n/ui";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro.url);
const t = dict[locale].common;
const post = getPostBySlug(slug, locale)!;
const category = getCategoryById(post.category, locale);
const related = getPostsByCategory(post.category, locale)
  .filter((item) => item.slug !== post.slug)
  .slice(0, 2);
const p = (path: string) => localePath(path, locale);
---

<BaseLayout title={`${post.title} | Jakša Tomović`} description={post.excerpt} image={post.image} type="article">
  <article>
    <header class="container-site pt-12 sm:pt-20">
      <div class="mx-auto max-w-3xl">
        <a href={p(category?.href ?? "/blog")} class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-muted transition hover:text-ink">
          <Icon name="chevronLeft" class="h-4 w-4" />
          {category?.label}
        </a>
        <h1 class="mt-6 text-display-lg font-semibold text-ink">{post.title}</h1>
        <p class="mt-6 text-lg text-muted sm:text-xl">{post.excerpt}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs uppercase tracking-[0.18em] text-muted">
          <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt, locale)}</time>
          <span>{post.readTime}</span>
          <span>Jakša Tomović</span>
        </div>
      </div>
    </header>

    <figure class="container-site mt-12">
      <div class="surface overflow-hidden">
        <img src={post.image} alt={post.imageAlt} class="max-h-[640px] w-full object-cover" width="1400" height="820" />
      </div>
    </figure>

    <div class="container-site mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="prose-site mx-auto w-full max-w-3xl">
        {post.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {post.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="surface p-6">
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-muted">{t.filedUnder}</p>
          <a href={p(category?.href ?? "/blog")} class="mt-3 inline-flex rounded-full bg-ink px-4 py-1.5 text-sm font-semibold text-bg">{category?.label}</a>
          <ul class="mt-6 flex flex-wrap gap-1.5">
            {post.tags.map((tag) => (
              <li class="rounded-full bg-line/5 px-2.5 py-1 text-[0.7rem] font-medium text-ink/70">{tag}</li>
            ))}
          </ul>
          <a href={p("/blog")} class="link-arrow mt-7">
            {t.allNotes}
            <Icon name="arrow" />
          </a>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="container-site pt-24">
      <p class="eyebrow">{t.related}</p>
      <h2 class="mt-4 text-display-md font-semibold text-ink">{t.moreNotes.replace("{category}", (category?.label ?? "").toLowerCase())}</h2>
      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        {related.map((item, i) => (
          <BlogPostCard post={item} delay={i * 80} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
