---
import Icon from "../ui/Icon.astro";
import { getLocale, localePath } from "../../i18n";
import { getStudio } from "../../data/studio";
import { dict } from "../../i18n/ui";

const locale = getLocale(Astro.url);
const t = dict[locale];
const studio = getStudio(locale);
const p = (path: string) => localePath(path, locale);

const columns = [
  {
    title: t.footer.work,
    links: [
      { href: p("/about"), label: t.nav.about },
      { href: p("/apps/tonko"), label: "TONKO" },
      { href: studio.href, label: "Boiled Eggs Studio" },
      { href: p("/hardware"), label: t.nav.hardware },
      { href: p("/canarin-garage"), label: "Canarin Garage" },
    ],
  },
  {
    title: t.footer.writing,
    links: [
      { href: p("/blog"), label: t.common.allNotes },
      { href: p("/blog/apps"), label: t.footer.productNotes },
      { href: p("/blog/hardware"), label: t.footer.benchNotes },
      { href: p("/blog/garage"), label: t.footer.buildLog },
    ],
  },
];

const socials = [
  { href: "mailto:jaksa.tomovic@gmail.com", label: "Email", icon: "mail" as const },
  { href: "https://github.com/jaksatomovic", label: "GitHub", icon: "github" as const },
  { href: "https://www.linkedin.com/in/jaksatomovic/", label: "LinkedIn", icon: "linkedin" as const },
  { href: "https://www.instagram.com/canaringarage/", label: "Instagram", icon: "instagram" as const },
];
---

<footer class="mt-24 sm:mt-32">
  <section class="container-site">
    <div class="surface relative overflow-hidden px-6 py-14 sm:px-12 sm:py-20" data-reveal>
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p class="eyebrow">{t.footer.eyebrow}</p>
          <h2 class="mt-5 text-display-lg font-semibold text-ink" set:html={t.footer.title} />
          <p class="mt-5 max-w-xl text-base text-muted sm:text-lg">{t.footer.body}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-end">
          <a href="mailto:jaksa.tomovic@gmail.com" class="btn-primary">
            jaksa.tomovic@gmail.com
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/cv.pdf" download class="btn-secondary">
            {t.common.downloadCv}
            <Icon name="download" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-site mt-16 pb-10">
    <div class="grid gap-10 border-t border-line/10 pt-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href={p("/")} class="flex items-center gap-3">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink text-[0.7rem] font-bold tracking-wider text-bg">JT</span>
          <span class="text-sm font-semibold">Jakša Tomović</span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-muted">{t.footer.blurb}</p>
        <ul class="mt-6 flex items-center gap-2">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith("http") ? "_blank" : undefined}
                rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line/10 text-ink/70 transition hover:border-line/30 hover:text-ink"
                aria-label={s.label}
              >
                <Icon name={s.icon} class="h-[1.1rem] w-[1.1rem]" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      {columns.map((col) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">{col.title}</p>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-ink/80 transition hover:text-ink">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-line/10 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Jakša Tomović. {t.footer.rights}</p>
      <p>{t.footer.builtWith}</p>
    </div>
  </div>
</footer>
