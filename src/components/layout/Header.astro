---
const links = [
  { href: "/", label: "Home" },
  { href: "/apps", label: "Apps" },
  { href: "/hardware", label: "Hardware" },
  { href: "/canarin-garage", label: "Garage" },
  { href: "/blog", label: "Blog" },
  { href: "mailto:jaksa.tomovic@gmail.com", label: "Say hi", external: true },
];
---

<header class="py-4 sm:py-6">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <a href="/" class="flex min-w-0 items-center gap-2 text-base font-semibold text-primary dark:text-white sm:text-lg">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white dark:bg-white dark:text-primary">
          JT
        </span>
        <span class="truncate">Jakša Tomović</span>
      </a>

      <nav class="hidden lg:block" aria-label="Primary navigation">
        <ul class="flex items-center justify-end gap-1.5 sm:gap-2">
          {links.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors duration-200 hover:bg-primary/10 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-white dark:hover:bg-white/10 dark:focus-visible:outline-white"
                rel={external ? "noopener noreferrer" : undefined}
                target={external ? "_blank" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-primary/15 bg-white/80 text-primary shadow-lg shadow-primary/5 transition hover:bg-primary/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/15 dark:bg-secondary/80 dark:text-white dark:hover:bg-white/10 dark:focus-visible:outline-white [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
        >
          <span class="sr-only">Open navigation</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full z-50 mt-3 w-60 overflow-hidden rounded-lg border border-primary/10 bg-white/95 p-2 shadow-xl shadow-primary/10 backdrop-blur dark:border-white/10 dark:bg-primary/95"
          aria-label="Mobile primary navigation"
        >
          <ul class="grid gap-1">
            {links.map(({ href, label, external }) => (
              <li>
                <a
                  href={href}
                  class="block rounded-lg px-4 py-3 text-sm font-medium text-primary transition hover:bg-primary/10 dark:text-white dark:hover:bg-white/10"
                  rel={external ? "noopener noreferrer" : undefined}
                  target={external ? "_blank" : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll("[data-mobile-menu]").forEach((menu) => {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    });
  });
</script>
