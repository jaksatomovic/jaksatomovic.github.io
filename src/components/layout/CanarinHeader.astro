---
const links = [
  { href: "#overview", label: "Overview" },
  { href: "#timeline", label: "Build Timeline" },
  { href: "#engineering", label: "Engineering" },
  { href: "#specs", label: "Specs" },
  { href: "#blog", label: "Blog" },
  { href: "#gallery", label: "Gallery" },
  { href: "#contact", label: "Contact" },
];
---

<header class="bg-primary text-white">
  <div class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <a href="/" class="flex min-w-0 items-center gap-2 text-base font-semibold sm:text-lg">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-sm font-semibold text-primary">
          JT
        </span>
        <div class="flex min-w-0 flex-col leading-tight">
          <span>Canarin Garage</span>
          <span class="truncate text-xs font-normal tracking-wide text-white/80">Custom CX500 Build</span>
        </div>
      </a>

      <nav class="hidden lg:block" aria-label="Garage navigation">
        <ul class="flex items-center justify-end gap-1.5 sm:gap-2">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-200 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white shadow-lg shadow-black/10 transition hover:bg-white/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white [&::-webkit-details-marker]:hidden"
          aria-label="Open garage navigation"
        >
          <span class="sr-only">Open garage navigation</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full z-50 mt-3 w-64 overflow-hidden rounded-lg border border-white/10 bg-primary/95 p-2 shadow-xl shadow-black/20 backdrop-blur"
          aria-label="Mobile garage navigation"
        >
          <ul class="grid gap-1">
            {links.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="block rounded-lg px-4 py-3 text-sm font-medium text-white transition hover:bg-white/10"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll("[data-mobile-menu]").forEach((menu) => {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    });
  });
</script>
