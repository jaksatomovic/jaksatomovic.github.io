---
const surfaceBase =
  "rounded-lg border border-primary/10 bg-white/85 p-5 shadow-lg shadow-primary/5 transition duration-300 hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-primary/15 dark:border-white/10 dark:bg-secondary/70 dark:shadow-thick dark:hover:border-white/20 sm:p-7";
const quietSurface =
  "rounded-lg border border-primary/10 bg-white/85 p-5 shadow-lg shadow-primary/5 dark:border-white/10 dark:bg-secondary/70 dark:shadow-thick sm:p-7";
const iconButton =
  "flex h-12 w-12 items-center justify-center rounded-lg border border-primary/15 bg-zinc-50 text-primary ring-1 ring-primary/5 transition hover:-translate-y-0.5 hover:bg-primary/10 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/15 dark:bg-tertiary dark:text-white dark:ring-white/10 dark:hover:bg-white/10 dark:hover:text-white dark:focus-visible:outline-white";
const badge =
  "inline-flex items-center rounded-lg border border-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-primary/60 dark:border-white/15 dark:text-white/60";

const stacks = {
  airshare: ["Next.js", "TypeScript", "Tailwind CSS", "Iroh"],
  hardware: ["Moto32", "Keero Bot", "ESP32-S3", "AI Device"],
};
---

<section class="px-4 py-12 sm:px-6 lg:py-20">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-5 lg:grid-cols-12">
    <article class={`${quietSurface} lg:col-span-7`}>
      <div class="flex min-w-0 items-center gap-4">
        <img
          src="/images/avatar.jpg"
          alt="Portrait of Jakša Tomović"
          class="h-12 w-12 shrink-0 rounded-full border border-primary/20 object-cover ring-2 ring-primary/10 dark:border-white/10 dark:ring-white/10"
          width="96"
          height="96"
        />
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-primary dark:text-white">Jakša Tomović</p>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">Developer · Product Studio · Custom motorcycles</p>
        </div>
      </div>
      <h1 class="mt-8 text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-5xl">
        I build practical tools, embedded products, and custom machines.
      </h1>
      <p class="mt-6 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-base">
        I am a developer based in Croatia, focused on calm software that solves real problems and hardware that survives real use.
        Right now I am scaling
        <a
          href="https://tryairshare.com"
          class="font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition hover:text-primary/80 dark:text-white"
          target="_blank"
          rel="noopener noreferrer"
          >AirShare</a
        >, building
        <a
          href="/hardware"
          class="font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition hover:text-primary/80 dark:text-white"
          >Keero Bot</a
        >, a modular ESP32-S3 AI device platform with audio, sensing, haptics, display and camera paths, and module expansion,
        while documenting custom motorcycle work through
        <a
          href="/canarin-garage"
          class="font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition hover:text-primary/80 dark:text-white"
          >Canarin Garage</a
        >.
      </p>
    </article>

    <aside class={`${surfaceBase} flex flex-col justify-between lg:col-span-5`}>
      <header>
        <p class="text-xs uppercase tracking-[0.24em] text-primary/70 dark:text-white/70 sm:tracking-[0.35em]">
          Connect
        </p>
        <h2 class="mt-4 text-2xl font-semibold tracking-tight text-primary dark:text-white sm:text-3xl">
          Find me online
        </h2>
      </header>
      <div class="mt-8 grid grid-cols-4 gap-3">
        <a href="mailto:jaksa.tomovic@gmail.com" class={iconButton}>
          <span class="sr-only">Email</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2z" />
            <path d="M22 6l-10 7l-10 -7" />
          </svg>
        </a>
        <a href="https://github.com/jaksatomovic" class={iconButton} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">GitHub</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-4 1 -4 -2 -6 -2" />
            <path d="M15 19v-3.87a3.37 3.37 0 0 0 -.94 -2.61c3.14 -.35 6.44 -1.54 6.44 -7a5.44 5.44 0 0 0 -1.5 -3.75a5.07 5.07 0 0 0 -.09 -3.79s-1.2 -.38 -3.95 1.5a13.38 13.38 0 0 0 -7 0c-2.75 -1.88 -3.95 -1.5 -3.95 -1.5a5.07 5.07 0 0 0 -.09 3.79a5.44 5.44 0 0 0 -1.5 3.75c0 5.42 3.3 6.61 6.44 7a3.37 3.37 0 0 0 -.94 2.53v3.94" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/jaksatomovic/" class={iconButton} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">LinkedIn</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2z" />
            <path d="M8 11v5" />
            <path d="M8 8v.01" />
            <path d="M12 16v-5" />
            <path d="M16 16v-3a2 2 0 0 0 -4 0" />
          </svg>
        </a>
        <a
          href="https://www.instagram.com/canaringarage/profilecard/?igsh=MXZ2cHl2OGZxdTU4bg=="
          class={iconButton}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">Instagram</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2z" />
            <path d="M12 12m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0" />
            <path d="M16.5 7.5l0 .01" />
          </svg>
        </a>
      </div>
    </aside>

    <a
      href="/canarin-garage"
      class={`${surfaceBase} group overflow-hidden lg:col-span-7`}
    >
      <div class="grid gap-6 md:grid-cols-[1fr_18rem] md:items-center">
        <div class="space-y-4">
          <span class={badge}>Custom Garage</span>
          <h2 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-4xl">
            Canarin Garage
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
            One-off motorcycles built with the same care I put into software: clean systems, deliberate details, and parts that earn their place.
          </p>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition group-hover:translate-x-1 dark:text-white">
            Open garage
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="M12 5l7 7-7 7" />
            </svg>
          </span>
        </div>
        <img
          src="/images/canaringarage.jpg"
          alt="Custom motorcycle from Canarin Garage"
          class="h-56 w-full rounded-lg object-cover md:h-64"
          width="720"
          height="520"
        />
      </div>
    </a>

    <div class={`${quietSurface} flex flex-col justify-between lg:col-span-5`}>
      <h2 class="text-2xl font-semibold tracking-tight text-primary dark:text-white sm:text-3xl">
        Grab my resume
      </h2>
      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        Download a snapshot of my work across SaaS, product strategy, and hands-on engineering leadership.
      </p>
      <a
        href="/cv.pdf"
        download
        class="mt-8 inline-flex w-full items-center justify-between rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white transition hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-white dark:text-primary dark:hover:bg-white/90"
      >
        Download CV
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
          <path d="M7 11l5 5l5 -5" />
          <path d="M12 4v12" />
        </svg>
      </a>
    </div>

    <a
      href="https://tryairshare.com"
      class={`${surfaceBase} group lg:col-span-7`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class={badge}>Shipping now</span>
      <h2 class="mt-4 text-3xl font-semibold text-primary dark:text-white sm:text-4xl">AirShare</h2>
      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        Instant, encrypted file delivery over QUIC with local discovery and global relays when you need them.
        It keeps builds private and fast without turning every transfer into cloud storage.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {stacks.airshare.map((stack) => (
          <span class="rounded-lg border border-emerald-500/20 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-800 dark:border-emerald-300/20 dark:bg-emerald-300/10 dark:text-emerald-100">
            {stack}
          </span>
        ))}
      </div>
      <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-primary transition group-hover:translate-x-1 dark:text-white">
        Visit website
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="M12 5l7 7-7 7" />
        </svg>
      </span>
    </a>

    <a href="/hardware" class={`${surfaceBase} group lg:col-span-5`}>
      <span class={badge}>Hardware bench</span>
      <h2 class="mt-4 text-3xl font-semibold text-primary dark:text-white">Moto32 + Keero Bot</h2>
      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        Open motorcycle electronics plus Keero Bot, a compact ESP32-S3 AI-device core for interactive hardware: audio I/O,
        sensors, haptics, display and camera support, battery power, docks, and module expansion.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {stacks.hardware.map((stack) => (
          <span class="rounded-lg border border-sky-500/20 bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-sky-800 dark:border-sky-300/20 dark:bg-sky-300/10 dark:text-sky-100">
            {stack}
          </span>
        ))}
      </div>
      <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-primary transition group-hover:translate-x-1 dark:text-white">
        Open hardware
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="M12 5l7 7-7 7" />
        </svg>
      </span>
    </a>

    <a
      href="https://buymeacoffee.com/iamcanarin"
      target="_blank"
      rel="noopener noreferrer"
      class={`${surfaceBase} flex flex-col items-center justify-center text-center lg:col-span-5`}
    >
      <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" class="h-14 w-14" alt="Buy me a coffee" />
      <h2 class="mt-5 text-2xl font-semibold text-primary dark:text-white">Fuel the work</h2>
      <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
        If you dig the apps or the bikes, tip a coffee and keep the experiments rolling.
      </p>
    </a>

    <div class={`${quietSurface} flex flex-col items-center text-center lg:col-span-7`}>
      <h2 class="text-2xl font-semibold tracking-tight text-primary dark:text-white sm:text-3xl">
        Subscribe to updates
      </h2>
      <p class="mt-4 max-w-xl text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        Ship notes, product essays, and moto builds, occasional and useful.
      </p>
      <form class="mt-8 grid w-full gap-3 sm:grid-cols-[1fr_auto]">
        <label for="email-address" class="sr-only">Email address</label>
        <input
          type="email"
          name="email-address"
          id="email-address"
          autocomplete="email"
          required
          class="h-12 w-full rounded-lg border border-primary/10 bg-zinc-100 px-4 text-sm text-zinc-700 transition focus:border-primary/40 focus:outline-none focus:ring-2 focus:ring-primary/30 dark:border-white/15 dark:bg-tertiary dark:text-white"
          placeholder="Enter your email"
        />
        <button
          type="submit"
          class="inline-flex h-12 w-full items-center justify-center rounded-lg bg-primary px-6 text-sm font-semibold text-white transition hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-white dark:text-primary dark:hover:bg-white/90 sm:w-auto"
        >
          Subscribe
        </button>
      </form>
    </div>

    <div class={`${quietSurface} lg:col-span-12`}>
      <p class="text-lg font-medium text-primary dark:text-white sm:text-2xl">
        I care about simple systems, durable interfaces, and the kind of craft you can feel after the first week of real use.
      </p>
      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">
        Every project is a chance to blend engineering discipline with a garage builder's curiosity. If you are working on something ambitious, or just want to talk shop, I would love to hear from you.
      </p>
      <p class="mt-6 text-sm font-semibold text-primary dark:text-white">Jakša Tomović</p>
    </div>
  </div>
</section>
