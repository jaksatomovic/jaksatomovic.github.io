---
import BlogPostCard from "./BlogPostCard.astro";
import CategoryNav from "./CategoryNav.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { getCategoryById, getPostsByCategory } from "../../data/blog";
import type { BlogCategoryId } from "../../data/blog";
import { getLocale } from "../../i18n";
import { dict } from "../../i18n/ui";

interface Props {
  categoryId: BlogCategoryId;
}

const { categoryId } = Astro.props;
const locale = getLocale(Astro.url);
const category = getCategoryById(categoryId, locale)!;
const posts = getPostsByCategory(categoryId, locale);
---

<section class="container-site pt-12 sm:pt-20">
  <SectionHeading eyebrow={category.eyebrow} title={category.label} description={category.description} />
  <CategoryNav active={categoryId} />
</section>

<section class="container-site pt-12">
  {posts.length > 0 ? (
    <div class="grid gap-5 lg:grid-cols-2">
      {posts.map((post, i) => (
        <BlogPostCard post={post} delay={(i % 2) * 80} />
      ))}
    </div>
  ) : (
    <p class="surface p-8 text-muted">{dict[locale].common.nothingYet}</p>
  )}
</section>
