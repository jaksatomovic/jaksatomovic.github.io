---
import Icon from "../ui/Icon.astro";
import { formatPostDate, getCategoryById } from "../../data/blog";
import type { BlogPost } from "../../data/blog";
import { getLocale, localePath } from "../../i18n";
import { dict } from "../../i18n/ui";

interface Props {
  post: BlogPost;
  featured?: boolean;
  delay?: number;
}

const { post, featured = false, delay = 0 } = Astro.props;
const locale = getLocale(Astro.url);
const t = dict[locale].common;
const category = getCategoryById(post.category, locale);
---

<a
  href={localePath(`/blog/${post.slug}`, locale)}
  class:list={[
    "surface surface-hover group flex overflow-hidden",
    featured ? "flex-col lg:grid lg:grid-cols-[1.1fr_0.9fr]" : "flex-col",
  ]}
  data-reveal
  data-reveal-delay={delay}
>
  <div class:list={["overflow-hidden bg-raised", featured ? "aspect-[16/10] lg:aspect-auto lg:min-h-[24rem]" : "aspect-[16/10]"]}>
    <img
      src={post.image}
      alt={post.imageAlt}
      loading={featured ? "eager" : "lazy"}
      width="900"
      height="560"
      class="h-full w-full object-cover transition duration-700 ease-premium group-hover:scale-[1.03]"
    />
  </div>
  <div class:list={["flex flex-1 flex-col", featured ? "p-7 sm:p-10" : "p-6 sm:p-7"]}>
    <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.18em] text-muted">
      <span class="chip">{category?.label}</span>
      <time>{formatPostDate(post.publishedAt, locale)}</time>
      <span>{post.readTime}</span>
    </div>
    <h2 class:list={["mt-4 font-semibold tracking-tight text-ink transition group-hover:text-accent", featured ? "text-display-md" : "text-2xl"]}>
      {post.title}
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{post.excerpt}</p>
    <span class="link-arrow mt-auto pt-6">
      {t.readNote}
      <Icon name="arrow" />
    </span>
  </div>
</a>
