---
import { formatPostDate, getCategoryById } from "../../data/blog";
import type { BlogPost } from "../../data/blog";

const { post, featured = false } = Astro.props as {
  post: BlogPost;
  featured?: boolean;
};

const category = getCategoryById(post.category);
---

<article
  class={`group flex h-full flex-col overflow-hidden rounded-lg border border-primary/10 bg-white/85 shadow-lg shadow-primary/5 transition hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-primary/15 dark:border-white/10 dark:bg-secondary/70 dark:hover:border-white/20 ${featured ? "lg:grid lg:grid-cols-[1.05fr_0.95fr]" : ""}`}
>
  <a href={`/blog/${post.slug}`} class={featured ? "block min-h-72 lg:order-2" : "block"}>
    <img
      src={post.image}
      alt={post.imageAlt}
      class={`${featured ? "h-full min-h-72" : "aspect-[16/10]"} w-full object-cover transition duration-500 group-hover:scale-[1.02]`}
      loading={featured ? "eager" : "lazy"}
      width={featured ? "900" : "640"}
      height={featured ? "720" : "400"}
    />
  </a>

  <div class={`flex flex-1 flex-col ${featured ? "p-5 sm:p-7 lg:p-8" : "p-5 sm:p-6"}`}>
    <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.18em] text-primary/55 dark:text-white/55">
      <a href={category?.href ?? "/blog"} class="rounded-lg border border-primary/10 px-3 py-1 transition hover:border-primary/30 dark:border-white/15">
        {category?.label ?? post.category}
      </a>
      <span>{formatPostDate(post.publishedAt)}</span>
      <span>{post.readTime}</span>
    </div>

    <h2 class={`${featured ? "mt-5 text-3xl sm:text-4xl" : "mt-4 text-2xl"} font-semibold tracking-tight text-primary dark:text-white`}>
      <a href={`/blog/${post.slug}`} class="transition hover:text-primary/75 dark:hover:text-white/75">{post.title}</a>
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-base">{post.excerpt}</p>

    <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-wide text-primary/60 dark:text-white/60">
      {post.tags.map((tag) => (
        <li class="rounded-lg border border-primary/10 px-3 py-1 dark:border-white/15">{tag}</li>
      ))}
    </ul>

    <a
      href={`/blog/${post.slug}`}
      class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-white dark:text-primary dark:hover:bg-white/90 sm:w-auto"
    >
      Read note
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
