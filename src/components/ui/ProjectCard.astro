---
import Icon from "./Icon.astro";
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  variant?: "default" | "wide" | "tall";
  delay?: number;
}

const { project, variant = "default", delay = 0 } = Astro.props;
const external = project.href.startsWith("http");
---

<a
  href={project.href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "surface surface-hover group relative flex overflow-hidden",
    variant === "wide" ? "flex-col md:col-span-2 md:flex-row" : "flex-col",
    variant === "tall" && "md:row-span-2",
  ]}
  data-reveal
  data-reveal-delay={delay}
>
  <div
    class:list={[
      "relative overflow-hidden",
      variant === "wide" ? "aspect-[16/10] md:aspect-auto md:w-1/2" : "aspect-[16/10]",
    ]}
    style={`background: ${project.tone};`}
  >
    <img
      src={project.image}
      alt={project.imageAlt}
      loading="lazy"
      width="900"
      height="600"
      class:list={[
        "h-full w-full transition duration-700 ease-premium group-hover:scale-[1.03]",
        project.imageFit === "contain" ? "object-contain p-8 sm:p-10" : "object-cover",
      ]}
    />
  </div>

  <div class:list={["flex flex-1 flex-col p-6 sm:p-8", variant === "wide" && "md:justify-center"]}>
    <div class="flex items-center justify-between gap-3">
      <span class="eyebrow">{project.kicker}</span>
      <span class="chip">{project.status}</span>
    </div>
    <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{project.name}</h3>
    <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{project.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`${project.name} stack`}>
      {project.stack.map((s) => (
        <li class="rounded-full bg-line/5 px-2.5 py-1 text-[0.7rem] font-medium text-ink/70">{s}</li>
      ))}
    </ul>
    <span class="link-arrow mt-auto pt-6">
      {project.cta}
      <Icon name={external ? "external" : "arrow"} />
    </span>
  </div>
</a>
