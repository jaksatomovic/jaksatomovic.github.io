---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import BlogPostCard from "../../components/blog/BlogPostCard.astro";
import { getProjectsByArea } from "../../data/projects";
import { getPostsByCategory } from "../../data/blog";

const apps = getProjectsByArea("apps");
const posts = getPostsByCategory("apps").slice(0, 2);
---

<BaseLayout
  title="Apps | Jakša Tomović"
  description="Software products by Jakša Tomović: TONKO, a family Android app for pocket money, and AirShare, encrypted peer-to-peer file delivery."
>
  <section class="container-site pt-12 sm:pt-20">
    <SectionHeading
      eyebrow="Work"
      title="Apps"
      description="Software I have built and shipped, from the data model to the store listing."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {apps.map((p, i) => (
        <ProjectCard project={p} variant={i === 0 ? "wide" : "default"} delay={i * 80} />
      ))}
      <a href="mailto:jaksa.tomovic@gmail.com" class="surface surface-hover group flex flex-col justify-between p-6 sm:p-8" data-reveal data-reveal-delay={160}>
        <span class="eyebrow">Next</span>
        <div>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Working on something?</h3>
          <p class="mt-3 text-sm text-muted sm:text-base">
            If you need help with an Android app or a web product, feel free to reach out.
          </p>
        </div>
        <span class="link-arrow mt-8">
          Get in touch
          <Icon name="arrow" />
        </span>
      </a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="container-site pt-24 sm:pt-32">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="Product notes" title="Writing about the apps" size="md" />
        <a href="/blog/apps" class="link-arrow shrink-0" data-reveal>
          All product notes
          <Icon name="arrow" />
        </a>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {posts.map((post, i) => (
          <BlogPostCard post={post} delay={i * 80} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
