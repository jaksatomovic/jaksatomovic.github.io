---
import BlogCategoryListing from "../../../components/blog/BlogCategoryListing.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCategoryById } from "../../../data/blog";
import { getLocale } from "../../../i18n";
import { dict } from "../../../i18n/ui";

const locale = getLocale(Astro.url);
const category = getCategoryById("hardware", locale)!;
const suffix = dict[locale].blog.categoryTitleSuffix;
---

<BaseLayout title={`${category.label}${suffix ? " " + suffix : ""} | Jakša Tomović`} description={category.description}>
  <BlogCategoryListing categoryId="hardware" />
</BaseLayout>
