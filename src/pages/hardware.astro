---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Moto32",
    description:
      "Open-source motorcycle control unit you built as an ESP32-S3 alternative to commercial M-Unit style systems. Includes 8 MOSFET-protected outputs, USB-C programming, and full build documentation (schematics, BOM, Pick & Place, and 3D files).",
    href: "https://moto32.vercel.app",
    tech: ["ESP32-S3", "8 Protected Outputs", "USB-C", "Open Source Hardware"],
    external: true,
    status: "Built by Jaksa",
  },
  {
    name: "Keero Bot",
    description:
      "A modular, voice-first robotics platform built on ESP32-S3. Keero Bot combines local audio intelligence, expressive state logic, and extensible hardware modules into one cohesive system.",
    href: "https://keero.io",
    tech: ["ESP32-S3", "PlatformIO", "C++", "Audio DSP", "MCP Tools"],
    external: true,
    status: "Flagship build",
  },
];
---

<BaseLayout
  title="Hardware | Jaksa Tomovic"
  description="Moto32 and Keero Bot hardware projects by Jaksa Tomovic."
>
  <section class="px-4 py-12 sm:px-6 lg:py-20">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-10">
      <div class="max-w-3xl space-y-4">
        <p class="text-xs uppercase tracking-[0.24em] text-primary/70 dark:text-white/70 sm:tracking-[0.35em]">Hardware Lab</p>
        <h1 class="text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-5xl">
          Embedded products with a real-world bias
        </h1>
        <p class="text-base text-zinc-600 dark:text-zinc-400 sm:text-lg">
          A small, focused bench: Moto32 for motorcycles and Keero Bot for voice-first robotics.
        </p>
      </div>

      <article class="rounded-lg border border-primary/10 bg-white/80 p-5 shadow-lg shadow-primary/5 dark:border-white/10 dark:bg-secondary/70 sm:p-7">
        <h2 class="text-2xl font-semibold text-primary dark:text-white">Why this lab exists</h2>
        <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-base">
          Most hardware demos look exciting in short clips, but fall apart in daily use. The focus here is different:
          stable firmware, predictable behavior, maintainable module architecture, and interaction models that still feel good after months.
          Keero Bot is the primary vehicle for that approach.
        </p>
        <div class="mt-6 flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wide text-primary/60 dark:text-white/60">
          <span class="rounded-lg border border-primary/10 px-3 py-1 dark:border-white/15">Modular by design</span>
          <span class="rounded-lg border border-primary/10 px-3 py-1 dark:border-white/15">Local-first processing</span>
          <span class="rounded-lg border border-primary/10 px-3 py-1 dark:border-white/15">Behavior + firmware co-design</span>
        </div>
      </article>

      <div class="grid gap-5 md:grid-cols-2">
        {projects.map((project) => (
          <article class="flex h-full flex-col rounded-lg border border-primary/10 bg-white/80 p-5 shadow-lg shadow-primary/5 transition hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-primary/15 dark:border-white/10 dark:bg-secondary/70 dark:hover:border-white/20 sm:p-7">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-lg border border-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-primary/55 dark:border-white/15 dark:text-white/55">
                {project.status}
              </span>
            </div>
            <h2 class="mt-5 text-2xl font-semibold text-primary dark:text-white">{project.name}</h2>
            <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">{project.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wide text-primary/60 dark:text-white/60" aria-label={`${project.name} stack`}>
              {project.tech.map((stack) => (
                <li class="rounded-lg border border-primary/10 px-3 py-1 dark:border-white/15">{stack}</li>
              ))}
            </ul>
            <a
              href={project.href}
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
              class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-white dark:text-primary dark:hover:bg-white/90"
            >
              Open project
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="M12 5l7 7-7 7" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
