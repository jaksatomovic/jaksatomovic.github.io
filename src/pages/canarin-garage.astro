---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BlogPostCard from "../components/blog/BlogPostCard.astro";
import { getPostsByCategory } from "../data/blog";

const subnav = [
  { href: "#timeline", label: "Timeline" },
  { href: "#engineering", label: "Engineering" },
  { href: "#specs", label: "Build sheet" },
  { href: "#gallery", label: "Gallery" },
  { href: "#contact", label: "Contact" },
];

const stats = [
  { value: "0.199 mm", label: "Max deflection, ANSYS" },
  { value: "160 MPa", label: "Peak equivalent stress" },
  { value: "1.56", label: "Minimum safety factor" },
  { value: "17 in", label: "Custom spoked wheels" },
];

const timeline = [
  {
    date: "Fall 2024",
    title: "Source bike and documentation",
    body: "The 1981 CX500 donor, import paperwork, parts references and build notes were gathered before the project moved from old bike to full reinterpretation.",
  },
  {
    date: "November 2024",
    title: "CAD and static analysis",
    body: "Rear chassis and monoshock conversion modelled in SolidWorks, then checked in ANSYS with documented stress, deformation and safety-factor outputs.",
  },
  {
    date: "2025",
    title: "Teardown and fabrication",
    body: "Frame, engine and drivetrain separated. The rear section was opened up for the custom subframe, gussets, shock mounts and a compact Motogadget wiring layout.",
  },
  {
    date: "Now",
    title: "Coating, assembly and systems prep",
    body: "Coated chassis parts, custom 17-inch spoked wheels, KTM Duke 390 radiator packaging and electronics are being staged before final assembly.",
  },
];

const engineering = [
  {
    title: "CAD-modelled rear conversion",
    image: "/images/garage/cx500-chassis-cad.jpg",
    alt: "SolidWorks CAD model of the CX500 rear frame and monoshock conversion",
    body: "The subframe and monoshock conversion were modelled before fabrication so shock position, upper mounts and tail structure could be evaluated as one system.",
  },
  {
    title: "ANSYS stress review",
    image: "/images/garage/cx500-ansys-stress.jpg",
    alt: "ANSYS equivalent stress plot for the CX500 rear chassis conversion",
    body: "Static structural outputs give the build a paper trail: 160 MPa peak equivalent stress, 0.199 mm max deformation and a 1.56 minimum safety factor.",
  },
  {
    title: "Welded reinforcement",
    image: "/images/garage/cx500-weld-gusset.jpg",
    alt: "Close-up of welded gusset reinforcement on the CX500 frame",
    body: "Formed plates and careful TIG welds around the load path, instead of treating the rear section as a simple visual hoop.",
  },
];

const buildSheet = [
  {
    title: "Engine and drivetrain",
    items: [
      "CX500 497 cc longitudinal V-twin, full rebuild in progress",
      "OEM brown-code connecting rod bearings",
      "Murray's twin carb kit with K&N pod filters",
      "Custom stainless 2-into-2 exhaust, raised routing",
    ],
  },
  {
    title: "Chassis and suspension",
    items: [
      "CAD-modelled custom subframe and monoshock conversion",
      "ANSYS static structural analysis, 1.56 minimum safety factor",
      "YSS TCFX-MZ-366-280-TRL rear shock",
      "Suzuki GSX-R750 K7 USD forks, Cognito Moto triple tree, 30 mm offset",
      "Custom 17-inch spoked wheels",
    ],
  },
  {
    title: "Electronics",
    items: [
      "Motogadget M-Unit control system",
      "Motogadget Motoscope Pro display",
      "Compact wiring layout, integrated lighting and controls",
      "Rae-San programmable ignition paired with OEM pickup",
    ],
  },
  {
    title: "Cooling, brakes, finishing",
    items: [
      "KTM Duke 390 radiator conversion packaged around the USD front end",
      "Brembo rear caliper and GSX-R K7 rear disc under review",
      "Matte black surfaces, brushed hubs, gold anodised spoke nipples",
      "Minimal cockpit, short seat, neo-retro endurance proportions",
    ],
  },
];

const gallery = [
  {
    src: "/images/garage/img-2908.jpg",
    alt: "Honda CX500 cafe racer mock-up with tank and custom rear frame",
    caption: "Mock-up stage: longitudinal V-twin character inside a modern chassis direction.",
    span: "sm:col-span-2",
  },
  {
    src: "/images/garage/cx500-chassis-cad.jpg",
    alt: "SolidWorks CAD model of the CX500 custom monoshock rear frame",
    caption: "Rear frame, upper shock mount and tail structure modelled as one assembly.",
  },
  {
    src: "/images/garage/cx500-ansys-stress.jpg",
    alt: "ANSYS equivalent stress analysis for the CX500 rear chassis conversion",
    caption: "ANSYS check of peak equivalent stress for the rear conversion.",
  },
  {
    src: "/images/garage/cx500-weld-gusset.jpg",
    alt: "Welded gusset reinforcement on the CX500 frame",
    caption: "Welded reinforcement around the rear chassis load path.",
  },
  {
    src: "/images/garage/img-2907.jpg",
    alt: "Rear three-quarter view of the CX500 with monoshock and spoked wheel",
    caption: "Monoshock, custom subframe and 17-inch spoked wheel test fit.",
    span: "sm:col-span-2",
  },
  {
    src: "/images/garage/img-2909.jpg",
    alt: "Rear view of Honda CX500 custom subframe work in progress",
    caption: "Custom subframe and rear section before finishing work.",
  },
  {
    src: "/images/garage/img-2948.jpg",
    alt: "CX500 engine block on the workbench during rebuild",
    caption: "Engine rebuild: block, bearings and fresh electrics staged.",
  },
];

const posts = getPostsByCategory("garage").slice(0, 2);
---

<BaseLayout
  title="Canarin Garage | Honda CX500 custom build"
  description="Canarin Garage rebuilds a 1981 Honda CX500 as a neo-retro endurance cafe racer: CAD and ANSYS-checked monoshock chassis, GSX-R front end, custom 17-inch spoked wheels, Motogadget electronics."
  image="/images/garage/img-2908.jpg"
>
  <!-- Hero -->
  <section id="overview" class="relative isolate overflow-hidden bg-[#0d0d0e] text-white">
    <img
      src="/images/garage/img-2908.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      width="2000"
      height="1500"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0e] via-[#0d0d0e]/60 to-[#0d0d0e]/20" aria-hidden="true"></div>
    <div class="container-site relative flex min-h-[80vh] flex-col justify-end pb-14 pt-24 sm:pb-20">
      <div class="flex items-center gap-4">
        <img src="/images/canaringarage.jpg" alt="Canarin Garage badge" width="64" height="64" class="h-14 w-14 rounded-full bg-white object-cover p-1" />
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-white/60">Canarin Garage · Est. 2024</p>
          <p class="text-sm text-white/80">Custom motorcycles, Croatia</p>
        </div>
      </div>
      <h1 class="mt-8 max-w-3xl text-display-xl font-semibold">
        Honda CX500, <span class="font-serif italic font-normal text-accent">reinterpreted</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/75 sm:text-xl">
        A 1981 CX500 rebuilt as a neo-retro, endurance-inspired cafe racer. Old-school longitudinal V-twin, modern sportbike geometry, CAD and ANSYS-backed monoshock chassis, and a clean Motogadget ecosystem.
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        {["1981 CX500", "CAD + ANSYS", "YSS monoshock", "GSX-R750 K7 front", "17-inch spoked wheels", "Motogadget"].map((t) => (
          <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-medium text-white/85 backdrop-blur">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Sub navigation + stats -->
  <div class="sticky top-16 z-40 border-b border-line/10 bg-bg/80 backdrop-blur-xl sm:top-[4.5rem]">
    <nav class="container-site scroller flex gap-1 overflow-x-auto py-2" aria-label="On this page">
      {subnav.map((s) => (
        <a href={s.href} class="shrink-0 rounded-full px-4 py-2 text-sm font-medium text-ink/70 transition hover:bg-line/5 hover:text-ink">{s.label}</a>
      ))}
    </nav>
  </div>

  <section class="container-site pt-10">
    <dl class="grid gap-px overflow-hidden rounded-3xl border border-line/10 bg-line/10 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {stats.map((s) => (
        <div class="bg-surface p-6">
          <dd class="text-3xl font-semibold tracking-tight text-ink">{s.value}</dd>
          <dt class="mt-1 text-xs uppercase tracking-[0.18em] text-muted">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- Timeline -->
  <section id="timeline" class="container-site scroll-mt-32 pt-24 sm:pt-32">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading eyebrow="Progress" title="Build timeline" description="From documented engineering and frame work into coating, assembly, systems packaging and first-fire checks." class="lg:sticky lg:top-40 lg:self-start" />
      <ol class="relative border-l border-line/15 pl-8">
        {timeline.map((item, i) => (
          <li class="relative pb-10 last:pb-0" data-reveal data-reveal-delay={i * 60}>
            <span class:list={["absolute -left-[2.35rem] top-1.5 h-3 w-3 rounded-full border-2 border-bg", i === timeline.length - 1 ? "bg-accent" : "bg-ink"]}></span>
            <time class="text-xs uppercase tracking-[0.18em] text-muted">{item.date}</time>
            <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Engineering -->
  <section id="engineering" class="container-site scroll-mt-32 pt-24 sm:pt-32">
    <SectionHeading
      eyebrow="Engineering"
      title="Not just a <span class='font-serif italic font-normal text-accent'>visual</span> build"
      description="This is not a restoration. It is a performance-minded reinterpretation with CAD layout, static structural analysis, fabricated reinforcement and modern suspension geometry."
    />
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {engineering.map((item, i) => (
        <article class="surface surface-hover overflow-hidden" data-reveal data-reveal-delay={i * 80}>
          <img src={item.image} alt={item.alt} loading="lazy" class="aspect-[4/3] w-full object-cover" width="720" height="540" />
          <div class="p-6">
            <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Build sheet -->
  <section id="specs" class="container-site scroll-mt-32 pt-24 sm:pt-32">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading eyebrow="Setup" title="Build sheet" description="The current parts map, grouped by system." class="lg:sticky lg:top-40 lg:self-start" />
      <div class="grid gap-5 sm:grid-cols-2">
        {buildSheet.map((group, i) => (
          <article class="surface p-6" data-reveal data-reveal-delay={i * 60}>
            <h3 class="font-semibold text-ink">{group.title}</h3>
            <ul class="mt-4 space-y-2.5 text-sm text-muted">
              {group.items.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section id="gallery" class="container-site scroll-mt-32 pt-24 sm:pt-32">
    <SectionHeading eyebrow="Photo log" title="From donor bike to test fit" size="md" />
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {gallery.map((g, i) => (
        <figure class:list={["surface group overflow-hidden", g.span]} data-reveal data-reveal-delay={(i % 3) * 60}>
          <div class="aspect-[4/3] overflow-hidden bg-raised">
            <img src={g.src} alt={g.alt} loading="lazy" class="h-full w-full object-cover transition duration-700 ease-premium group-hover:scale-[1.03]" width="900" height="675" />
          </div>
          <figcaption class="px-5 py-4 text-sm text-muted">{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Notes -->
  {posts.length > 0 && (
    <section class="container-site pt-24 sm:pt-32">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="Build log" title="Longer notes from the shop" size="md" />
        <a href="/blog/garage" class="link-arrow shrink-0" data-reveal>
          All garage notes
          <Icon name="arrow" />
        </a>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {posts.map((post, i) => (
          <BlogPostCard post={post} delay={i * 80} />
        ))}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact" class="container-site scroll-mt-32 pt-24 sm:pt-32">
    <div class="surface grid gap-8 p-8 sm:p-12 lg:grid-cols-[1fr_1fr] lg:items-center" data-reveal>
      <div>
        <p class="eyebrow">Get involved</p>
        <h2 class="mt-4 text-display-md font-semibold text-ink">Collaborate, sponsor parts, or shoot the finished build</h2>
        <p class="mt-4 text-muted">Parts partners, photographers and fellow builders welcome. The CX500 will be on the road and at Grobnik.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <a href="mailto:canarin.garage@gmail.com" class="btn-primary">
          canarin.garage@gmail.com
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="https://www.instagram.com/canaringarage/" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <Icon name="instagram" class="h-4 w-4" />
          @canaringarage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
