---
import CanarinLayout from "../layouts/CanarinLayout.astro";

const stats = [
  { value: "0.199 mm", label: "ANSYS Max Deflection" },
  { value: "160 MPa", label: "Peak Stress Check" },
  { value: "1.56", label: "Minimum Safety Factor" },
  { value: "Q2 '26", label: "Road Test ETA" },
];

const timelineItems = [
  {
    date: "Fall 2024",
    title: "Source Bike & Documentation",
    body: "CX500 donor bike, import paperwork, parts references, and build documentation were gathered before cutting into the chassis.",
  },
  {
    date: "November 2024",
    title: "CAD & Static Analysis",
    body: "Rear chassis and monoshock conversion modeled in CAD, then checked in ANSYS with documented stress, deformation, and safety-factor outputs.",
  },
  {
    date: "2025",
    title: "Teardown & Fabrication",
    body: "Frame, engine, and drivetrain separated. The rear section was opened up for the custom loop, gussets, shock mounts, and new electronics layout.",
  },
  {
    date: "Current Phase",
    title: "Coating, Assembly & Wiring Prep",
    body: "Coated chassis parts, refreshed components, wheels, and electronics are being staged before final engine install, harness routing, and first-fire checks.",
  },
];

const shopNotes = [
  {
    label: "Engineering",
    title: "Static Chassis Check",
    body: "ANSYS static structural review documented a 160 MPa peak equivalent stress, 0.199 mm total deformation, and a 1.56 minimum safety factor for the rear conversion concept.",
    meta: "Report: Nov 2024",
  },
  {
    label: "Fabrication",
    title: "Gusseted Rear Section",
    body: "The custom rear frame uses welded reinforcement around the shock and seat support area so the cafe tail is structural, not just cosmetic.",
    meta: "Process: TIG + fit-up",
  },
  {
    label: "Finishing",
    title: "Black + Gold Direction",
    body: "Black wheel hardware, gold nipples, coated frame parts, and brushed-metal details are being staged toward the final black/gold/aluminum palette.",
    meta: "Palette: locked direction",
  },
];

const engineeringHighlights = [
  {
    title: "CAD-modeled rear conversion",
    image: "/images/garage/cx500-chassis-cad.jpg",
    alt: "SolidWorks CAD model of the CX500 rear frame and monoshock conversion",
    body: "The rear chassis conversion was modeled before fabrication so shock position, upper mounts, and tail structure could be evaluated as one system.",
  },
  {
    title: "ANSYS stress review",
    image: "/images/garage/cx500-ansys-stress.jpg",
    alt: "ANSYS equivalent stress plot for the CX500 rear chassis conversion",
    body: "Static structural outputs give the build a paper trail: 160 MPa peak equivalent stress, 0.199 mm max deformation, and a 1.56 minimum safety factor.",
  },
  {
    title: "Welded reinforcement",
    image: "/images/garage/cx500-weld-gusset.jpg",
    alt: "Close-up of welded gusset reinforcement on the CX500 frame",
    body: "The frame work is reinforced with formed plates and careful welds around the load path instead of relying on a simple visual rear hoop.",
  },
];

const buildSheet = [
  {
    title: "Engine & Drivetrain",
    items: [
      "CX500 497cc longitudinal V-twin, full rebuild in progress",
      "OEM brown-code connecting rod bearings on order",
      "Murray's twin carb kit with K&N pod filters",
      "Custom stainless 2-into-2 exhaust layout in progress",
    ],
  },
  {
    title: "Chassis & Suspension",
    items: [
      "CAD-modeled rear frame and monoshock conversion",
      "ANSYS static structural analysis with 1.56 minimum safety factor",
      "Welded gussets and bespoke mounting plates for the custom tail",
      "GSXR 750 front-end direction with custom conversion parts",
    ],
  },
  {
    title: "Electronics",
    items: [
      "Motogadget m-unit blue and M-Lock keyless ignition",
      "Motoscope Pro display with bar-end LED indicators",
      "Rae-San programmable ignition paired with OEM pickup",
      "Full new wiring harness with braided sheathing",
    ],
  },
  {
    title: "Finishing",
    items: [
      "Coated frame and hubs staged for final assembly",
      "Satin black tank direction with brushed aluminum panel concept",
      "Black rims, brushed hubs, and gold anodized spoke nipples",
      "Seat concept and upholstery still open",
    ],
  },
];

const galleryImages = [
  {
    src: "/images/garage/cx500-source-bike.jpg",
    alt: "Original Honda CX500 donor bike before the cafe racer conversion",
    caption: "The source bike before the chassis, suspension, and electronics work began.",
  },
  {
    src: "/images/garage/cx500-chassis-cad.jpg",
    alt: "SolidWorks CAD model of the CX500 custom monoshock rear frame",
    caption: "CAD stage: rear frame, upper shock mount, and tail structure modeled as one assembly.",
  },
  {
    src: "/images/garage/cx500-ansys-stress.jpg",
    alt: "ANSYS equivalent stress analysis for the CX500 rear chassis conversion",
    caption: "ANSYS check showing peak equivalent stress for the rear conversion concept.",
  },
  {
    src: "/images/garage/cx500-weld-gusset.jpg",
    alt: "Welded gusset reinforcement on the CX500 frame",
    caption: "Welded reinforcement around the rear chassis load path.",
  },
  {
    src: "/images/garage/img-2907.jpg",
    alt: "Honda CX500 cafe racer build in the garage, side profile during teardown",
    caption: "Day one with the high-mile CX500 stripped for inspection.",
  },
  {
    src: "/images/garage/img-2908.jpg",
    alt: "Close-up of Honda CX500 engine and frame during mock-up phase",
    caption: "Frame, engine, and suspension hardware aligned during mock-up.",
  },
  {
    src: "/images/garage/img-2909.jpg",
    alt: "Rear view of Honda CX500 custom subframe work in progress",
    caption: "Custom subframe and rear section test fit before finishing work.",
  },
  {
    src: "/images/garage/img-2948.jpg",
    alt: "Honda CX500 parts laid out on workbench for rebuild",
    caption: "Parts staging with refreshed components and new electrics.",
  },
  {
    src: "/images/garage/cx500-coated-frame.jpg",
    alt: "Coated CX500 frame and hubs staged for reassembly",
    caption: "Coated frame pieces and hubs staged before final reassembly.",
  },
  {
    src: "/images/garage/cx500-wheel-detail.jpg",
    alt: "Black spoked wheel with gold nipples for the CX500 cafe racer",
    caption: "Black wheel hardware with gold spoke nipples defining the finish direction.",
  },
];
---

<CanarinLayout>
  <section id="overview" class="relative isolate min-h-[620px] overflow-hidden bg-primary text-white">
    <img
      src="/images/garage/img-2908.jpg"
      alt="Honda CX500 cafe racer engine and frame in the Canarin Garage workshop"
      class="absolute inset-0 h-full w-full object-cover"
      width="1400"
      height="900"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/55 to-primary"></div>
    <div class="relative mx-auto flex min-h-[620px] max-w-6xl flex-col justify-end px-4 pb-12 pt-28 sm:px-6 lg:pb-16">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.24em] text-white/70 sm:tracking-[0.35em]">Build Log</p>
        <h1 class="mt-5 text-4xl font-semibold leading-tight sm:text-6xl">
          Honda CX500 Cafe Racer
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">
          A documented 1981 CX500 rebuild with CAD-modeled rear chassis work, ANSYS static analysis, welded reinforcement,
          GSXR front-end direction, Motogadget controls, Rae-San ignition, and a full monoshock conversion.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-wide text-white/75">
        {["CAD + ANSYS", "Welded Rear Frame", "YSS Monoshock", "Motogadget Suite", "GSXR Front End"].map((tag) => (
          <span class="rounded-lg border border-white/25 bg-white/10 px-3 py-2 backdrop-blur">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary px-4 pb-12 text-white sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="rounded-lg border border-white/10 bg-white/10 p-5 text-center shadow-lg shadow-black/10 backdrop-blur">
          <p class="text-3xl font-semibold">{stat.value}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.22em] text-white/60">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-zinc-100 py-14 dark:bg-primary" id="timeline">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
      <div class="lg:sticky lg:top-8 lg:self-start">
        <p class="text-xs uppercase tracking-[0.24em] text-primary/60 dark:text-white/50 sm:tracking-[0.3em]">Progress</p>
        <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Build Timeline</h2>
        <p class="mt-4 text-primary/70 dark:text-white/70">
          The project is moving from documented engineering and frame work into coating, assembly, wiring prep, and first-fire checks.
        </p>
      </div>
      <ol class="space-y-4">
        {timelineItems.map((item) => (
          <li class="rounded-lg border border-primary/10 bg-white/85 p-5 shadow-sm dark:border-white/10 dark:bg-white/5 sm:p-6">
            <time class="text-xs uppercase tracking-[0.18em] text-primary/55 dark:text-white/55">{item.date}</time>
            <h3 class="mt-2 text-xl font-semibold text-primary dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-primary/70 dark:text-white/70 sm:text-base">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-white py-14 dark:bg-primary/95" id="engineering">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.24em] text-primary/50 dark:text-white/50 sm:tracking-[0.3em]">Engineering</p>
        <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Not just a visual build</h2>
        <p class="mt-3 text-primary/70 dark:text-white/70">
          The rear conversion has a paper trail: CAD layout, static structural analysis, and fabricated reinforcement before finishing work.
        </p>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {engineeringHighlights.map((item) => (
          <article class="overflow-hidden rounded-lg border border-primary/10 bg-zinc-50 shadow-md shadow-primary/5 dark:border-white/10 dark:bg-white/5">
            <img
              src={item.image}
              alt={item.alt}
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
              width="720"
              height="540"
            />
            <div class="p-5 sm:p-6">
              <h3 class="text-xl font-semibold text-primary dark:text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-primary/70 dark:text-white/70">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-zinc-100 py-14 dark:bg-primary" id="workbench">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-primary/50 dark:text-white/50 sm:tracking-[0.3em]">Workbench</p>
          <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Latest Shop Notes</h2>
          <p class="mt-3 max-w-2xl text-primary/70 dark:text-white/70">
            A tighter view of what is happening on the bench right now: fabrication, wiring, and finishing decisions.
          </p>
        </div>
        <a
          href="#contact"
          class="inline-flex w-full items-center justify-center rounded-lg border border-primary/10 px-4 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary transition hover:border-primary/40 hover:text-primary/80 dark:border-white/20 dark:text-white/70 dark:hover:border-white/40 dark:hover:text-white sm:w-auto"
        >
          Share tips
        </a>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {shopNotes.map((note) => (
          <article class="rounded-lg border border-primary/10 bg-zinc-50 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-lg dark:border-white/10 dark:bg-white/5 sm:p-6">
            <span class="text-xs uppercase tracking-[0.22em] text-primary/60 dark:text-white/60">{note.label}</span>
            <h3 class="mt-3 text-xl font-semibold text-primary dark:text-white">{note.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-primary/70 dark:text-white/70">{note.body}</p>
            <p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-primary/50 dark:text-white/50">{note.meta}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 dark:bg-primary/95" id="specs">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-xs uppercase tracking-[0.24em] text-primary/50 dark:text-white/50 sm:tracking-[0.3em]">Setup</p>
        <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Build Sheet</h2>
        <p class="mt-4 text-primary/70 dark:text-white/70">
          The current parts map, grouped by system so the build is easier to scan on desktop and phone.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {buildSheet.map((group) => (
          <article class="rounded-lg border border-primary/10 bg-white/85 p-5 shadow-sm dark:border-white/10 dark:bg-white/5 sm:p-6">
            <h3 class="text-lg font-semibold text-primary dark:text-white">{group.title}</h3>
            <ul class="mt-4 space-y-2 text-sm text-primary/70 dark:text-white/70">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="bg-white py-14 dark:bg-primary/95">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.24em] text-primary/60 dark:text-white/50 sm:tracking-[0.3em]">Media</p>
        <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Photo Log</h2>
        <p class="mt-3 text-primary/70 dark:text-white/70">
          Build photos with enough context to make the progress easy to follow.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {galleryImages.map(({ src, alt, caption }) => (
          <figure class="overflow-hidden rounded-lg border border-primary/10 bg-zinc-50 shadow-md shadow-primary/5 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-white/5">
            <img
              src={src}
              alt={alt}
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
              width="600"
              height="450"
            />
            <figcaption class="px-4 py-3 text-sm text-primary/70 dark:text-white/70">{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-primary py-14 text-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="text-xs uppercase tracking-[0.24em] text-white/55 sm:tracking-[0.3em]">Contact</p>
        <h2 class="mt-3 text-3xl font-semibold">Share Feedback or Get Involved</h2>
        <p class="mt-4 text-white/78">
          Want to collaborate, sponsor parts, or schedule a shoot of the finished build? Reach out and let's make it happen.
        </p>
        <dl class="mt-8 grid gap-4 text-sm text-white/80 sm:grid-cols-2">
          <div>
            <dt class="text-xs uppercase tracking-[0.22em] text-white/55">Email</dt>
            <dd class="mt-1">
              <a href="mailto:canarin.garage@gmail.com" class="underline decoration-white/40 underline-offset-4 hover:decoration-white">
                canarin.garage@gmail.com
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.22em] text-white/55">Location</dt>
            <dd class="mt-1">Velika Gorica, Croatia</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.22em] text-white/55">Instagram</dt>
            <dd class="mt-1">
              <a href="https://instagram.com/canaringarage" target="_blank" rel="noopener noreferrer" class="underline decoration-white/40 underline-offset-4 hover:decoration-white">
                @canaringarage
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.22em] text-white/55">Ignition</dt>
            <dd class="mt-1">Rae-San programmable + Motogadget suite</dd>
          </div>
        </dl>
      </div>

      <form class="rounded-lg border border-white/10 bg-white/10 p-5 backdrop-blur sm:p-6">
        <h3 class="text-lg font-semibold text-white">Subscribe to build drops</h3>
        <p class="mt-3 text-sm text-white/75">
          Get notified when new gallery sets, fabrication notes, or tuning insights are published.
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto]">
          <label for="garage-email" class="sr-only">Email address</label>
          <input
            id="garage-email"
            type="email"
            placeholder="you@garagecrew.com"
            class="h-12 w-full rounded-lg border border-white/20 bg-white/10 px-4 text-sm text-white placeholder-white/50 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/25"
            required
          />
          <button type="submit" class="h-12 rounded-lg bg-white px-6 text-sm font-semibold text-primary transition hover:bg-white/90">
            Notify Me
          </button>
        </div>
      </form>
    </div>
  </section>
</CanarinLayout>
