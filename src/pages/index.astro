---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import PhoneFrame from "../components/ui/PhoneFrame.astro";
import { projects, getProject } from "../data/projects";
import { formatPostDate, getCategoryById, sortPosts } from "../data/blog";

const tonko = getProject("tonko");
const rest = projects.filter((p) => p.id !== "tonko");
const latestPosts = sortPosts().slice(0, 4);

const capabilities = [
  {
    icon: "phone",
    title: "Mobile apps",
    body: "Android in Kotlin: app architecture, offline data, Play Store release and billing.",
  },
  {
    icon: "layers",
    title: "Product and web",
    body: "Next.js and TypeScript web products, from landing pages to full apps.",
  },
  {
    icon: "cpu",
    title: "Embedded hardware",
    body: "ESP32-S3 boards, C++ firmware, audio and sensors, PCB layout and documentation.",
  },
  {
    icon: "wrench",
    title: "Fabrication",
    body: "CAD, basic structural checks and TIG welding, mostly on the CX500.",
  },
] as const;

const now = [
  { label: "Launching", value: "TONKO on Google Play", href: "/apps/tonko" },
  { label: "Scaling", value: "AirShare file delivery", href: "https://tryairshare.com" },
  { label: "Prototyping", value: "Keero Bot mainboard v2", href: "/hardware#keero" },
  { label: "Building", value: "CX500 monoshock chassis", href: "/canarin-garage" },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="container-site pb-16 pt-12 sm:pb-24 sm:pt-20 lg:pt-28">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div>
        <p class="eyebrow animate-rise">Developer · Croatia</p>
        <h1 class="mt-6 text-display-xl font-semibold text-ink animate-rise [animation-delay:80ms]">
          I build apps, hardware and the
          <span class="font-serif italic font-normal text-accent">occasional</span>
          motorcycle.
        </h1>
        <p class="mt-7 max-w-xl text-lg text-muted animate-rise [animation-delay:160ms] sm:text-xl">
          Developer based in Croatia. Currently working on TONKO, an Android app for families, alongside a few hardware projects and a Honda CX500 rebuild.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3 animate-rise [animation-delay:240ms]">
          <a href="#work" class="btn-primary">
            Selected work
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/apps/tonko" class="btn-secondary">
            <img src="/images/tonko/icon.png" alt="" width="20" height="20" class="h-5 w-5 rounded-md" />
            New: TONKO case study
          </a>
        </div>
        <div class="mt-12 flex items-center gap-4 animate-rise [animation-delay:320ms]">
          <img
            src="/images/avatar.jpg"
            alt="Portrait of Jakša Tomović"
            width="96"
            height="96"
            class="h-12 w-12 rounded-full object-cover ring-2 ring-line/10"
          />
          <div class="text-sm">
            <p class="font-semibold text-ink">Jakša Tomović</p>
            <p class="text-muted">Developer · Croatia</p>
          </div>
        </div>
      </div>

      <div class="relative animate-rise [animation-delay:200ms]">
        <div class="pointer-events-none absolute -inset-10 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative grid grid-cols-[1fr_1fr] items-end gap-4">
          <div class="translate-y-6">
            <PhoneFrame src="/images/tonko/phone-02.jpg" alt="TONKO screen: choosing where new money goes" eager />
          </div>
          <div class="-translate-y-4">
            <PhoneFrame src="/images/tonko/phone-01.jpg" alt="TONKO kid home screen with pocket balance and three jars" eager />
          </div>
          <img
            src="/images/tonko/mascot-wave.webp"
            alt=""
            width="720"
            height="738"
            class="pointer-events-none absolute -bottom-6 -left-10 w-32 animate-float drop-shadow-2xl sm:w-40"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Now strip -->
  <section class="container-site">
    <ul class="surface grid divide-y divide-line/10 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x" data-reveal>
      {now.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-between gap-3 px-6 py-5"
          >
            <span>
              <span class="eyebrow">{item.label}</span>
              <span class="mt-1.5 block text-sm font-semibold text-ink">{item.value}</span>
            </span>
            <Icon name="arrow" class="h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-ink" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Work -->
  <section id="work" class="container-site scroll-mt-24 pt-24 sm:pt-32">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        eyebrow="Projects"
        title="What I am working on"
        description="A few projects in different stages: one launching, one live, two on the bench and one in the garage."
      />
      <a href="/apps" class="link-arrow shrink-0" data-reveal>
        All apps
        <Icon name="arrow" />
      </a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <ProjectCard project={tonko} variant="wide" />
      {rest.map((p, i) => (
        <ProjectCard project={p} delay={(i % 2) * 90} />
      ))}
    </div>
  </section>

  <!-- Capabilities -->
  <section class="container-site pt-24 sm:pt-32">
    <SectionHeading
      eyebrow="Areas"
      title="Areas I work in"
      description="Software first, hardware when the project needs it, and some metalwork on weekends."
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {capabilities.map((c, i) => (
        <article class="surface surface-hover p-6 sm:p-7" data-reveal data-reveal-delay={i * 80}>
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-ink text-bg">
            <Icon name={c.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-6 text-lg font-semibold text-ink">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{c.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Principles -->
  <section class="container-site pt-24 sm:pt-32">
    <div class="surface overflow-hidden" data-reveal>
      <div class="grid lg:grid-cols-[1fr_1fr]">
        <div class="p-8 sm:p-12">
          <p class="eyebrow">How I work</p>
          <p class="mt-6 text-display-md font-semibold text-ink">
            I try to keep things simple: clear interfaces, predictable behaviour, and code that is still readable a year later.
          </p>
          <p class="mt-6 text-base text-muted">
            Most of what I have learned came from finishing projects and then living with them. That shapes how I plan the next one.
          </p>
        </div>
        <ul class="grid divide-y divide-line/10 border-t border-line/10 lg:border-l lg:border-t-0">
          {[
            ["01", "Local first", "Things should work without waiting on a server."],
            ["02", "Calm by default", "Fewer screens, obvious state, clear next step."],
            ["03", "Plan before the expensive step", "CAD, schematics and notes before cutting metal or ordering boards."],
            ["04", "Built to keep changing", "Structure that still makes sense after a year of updates."],
          ].map(([n, t, b]) => (
            <li class="flex gap-5 px-8 py-6 sm:px-10">
              <span class="font-mono text-xs text-accent">{n}</span>
              <div>
                <p class="font-semibold text-ink">{t}</p>
                <p class="mt-1 text-sm text-muted">{b}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="container-site pt-24 sm:pt-32">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Writing" title="Field notes" size="md" description="Product notes, bench notes and the CX500 build log." />
      <a href="/blog" class="link-arrow shrink-0" data-reveal>
        All notes
        <Icon name="arrow" />
      </a>
    </div>
    <ul class="mt-10 divide-y divide-line/10 border-y border-line/10" data-reveal>
      {latestPosts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="group grid gap-2 py-5 sm:grid-cols-[9rem_1fr_auto] sm:items-center sm:gap-6">
            <time class="text-xs uppercase tracking-[0.18em] text-muted">{formatPostDate(post.publishedAt)}</time>
            <span class="text-lg font-semibold tracking-tight text-ink transition group-hover:text-accent">{post.title}</span>
            <span class="chip justify-self-start sm:justify-self-end">{getCategoryById(post.category)?.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
