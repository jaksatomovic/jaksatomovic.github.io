---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostCard from "../../components/blog/BlogPostCard.astro";
import CategoryNav from "../../components/blog/CategoryNav.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { featuredPost, sortPosts } from "../../data/blog";

const posts = sortPosts().filter((post) => post.slug !== featuredPost.slug);
---

<BaseLayout
  title="Writing | Jakša Tomović"
  description="Notes on apps, embedded hardware, Keero Bot, Moto32 and the Canarin Garage CX500 build."
>
  <section class="container-site pt-12 sm:pt-20">
    <SectionHeading
      eyebrow="Writing"
      title="Field <span class='font-serif italic font-normal text-accent'>notes</span>"
      description="Product decisions, bench notes and the CX500 build log. One blog, three tracks, so each thread stays easy to follow."
    />
    <CategoryNav active="all" />
  </section>

  <section class="container-site pt-12">
    <BlogPostCard post={featuredPost} featured />
  </section>

  <section class="container-site pt-5">
    <div class="grid gap-5 lg:grid-cols-2">
      {posts.map((post, i) => (
        <BlogPostCard post={post} delay={(i % 2) * 80} />
      ))}
    </div>
  </section>
</BaseLayout>
