---
import BlogPostCard from "../../components/blog/BlogPostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogCategories, featuredPost, getPostsByCategory, sortPosts } from "../../data/blog";

const posts = sortPosts();
const latestPosts = posts.filter((post) => post.slug !== featuredPost.slug);
---

<BaseLayout
  title="Blog | Jaksa Tomovic"
  description="Notes from Jaksa Tomovic on apps, hardware, Keero Bot, Moto32, and Canarin Garage motorcycle builds."
>
  <section class="px-4 py-12 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-primary/70 dark:text-white/70 sm:tracking-[0.35em]">Field Notes</p>
          <h1 class="mt-4 text-3xl font-semibold tracking-tight text-primary dark:text-white sm:text-5xl">
            Blog for apps, hardware, and garage builds
          </h1>
        </div>
        <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-lg">
          A single place for product decisions, embedded hardware work, and Canarin Garage build logs, split into focused categories so each thread stays easy to follow.
        </p>
      </div>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Blog categories">
        {blogCategories.map((category) => (
          <a
            href={category.href}
            class="rounded-lg border border-primary/10 bg-white/70 px-4 py-2 text-sm font-semibold text-primary transition hover:border-primary/30 hover:bg-white dark:border-white/15 dark:bg-secondary/70 dark:text-white dark:hover:border-white/30"
          >
            {category.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="px-4 pb-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <BlogPostCard post={featuredPost} featured />
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-primary/60 dark:text-white/60">Categories</p>
          <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Separated without scattering</h2>
        </div>
      </div>

      <div class="mt-7 grid gap-5 md:grid-cols-3">
        {blogCategories.map((category) => {
          const categoryPosts = getPostsByCategory(category.id);
          return (
            <a
              href={category.href}
              class="rounded-lg border border-primary/10 bg-white/85 p-5 shadow-lg shadow-primary/5 transition hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-primary/15 dark:border-white/10 dark:bg-secondary/70 dark:hover:border-white/20 sm:p-6"
            >
              <p class="text-xs uppercase tracking-[0.22em] text-primary/55 dark:text-white/55">{category.eyebrow}</p>
              <h3 class="mt-3 text-2xl font-semibold text-primary dark:text-white">{category.label}</h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{category.description}</p>
              <p class="mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-primary/55 dark:text-white/55">
                {categoryPosts.length} {categoryPosts.length === 1 ? "note" : "notes"}
              </p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6 lg:pb-20">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.24em] text-primary/60 dark:text-white/60">Latest</p>
          <h2 class="mt-2 text-3xl font-semibold text-primary dark:text-white">Recent Notes</h2>
        </div>
      </div>

      <div class="mt-7 grid gap-5 lg:grid-cols-2">
        {latestPosts.map((post) => (
          <BlogPostCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
