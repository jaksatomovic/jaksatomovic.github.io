---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { getLocale, localePath, stripLocale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  tone?: "default" | "garage";
}

const { title, description, image, type, tone = "default" } = Astro.props;
const locale = getLocale(Astro.url);
const site = "https://jaksatomovic.github.io";
const canonicalPath = stripLocale(Astro.url.pathname);
const alternates = {
  en: new URL(localePath(canonicalPath, "en"), site).toString(),
  hr: new URL(localePath(canonicalPath, "hr"), site).toString(),
};
---

<html lang={locale}>
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="hr" href={alternates.hr} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    <slot name="head" />
  </head>
  <body class:list={["min-h-screen overflow-x-hidden font-sans", tone === "garage" && "tone-garage"]}>
    <div class="site-backdrop" aria-hidden="true"></div>
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window && targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = Number(el.dataset.revealDelay ?? 0);
                el.style.transitionDelay = `${delay}ms`;
                el.classList.add("is-visible");
                io.unobserve(el);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
